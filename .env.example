# Optional static-server port; defaults to 3000.
PORT=3000

# Optional runtime mode. Use production for the built Express host.
NODE_ENV=development

# Optional structured-log verbosity for the Express host.
LOG_LEVEL=info

# Reserved platform endpoint; unused by the browser-local MVP unless an approved adapter is added.
BUILT_IN_FORGE_API_URL=

# Reserved platform credential; never commit a real key.
BUILT_IN_FORGE_API_KEY=
